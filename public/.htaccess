# janeleiro.dev na Hostinger (LiteSpeed/Apache)

# Sempre HTTPS e sem "www", num redirecionamento só
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://janeleiro.dev%{REQUEST_URI} [L,R=301]

# Página de erro do próprio site ("Game over")
ErrorDocument 404 /404.html

# Compressão de texto (HTML, CSS, JS, SVG, XML)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache
<IfModule mod_headers.c>
  # Arquivos com hash no nome (fontes, JS do Astro): nunca mudam, cache de 1 ano
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Imagens: 30 dias (mudam pouco, mas sem hash no nome)
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML: sempre confere se há versão nova
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
