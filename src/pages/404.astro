---
import Base from '../layouts/Base.astro';
---

<Base title="Game over" description="Página não encontrada." noindex>
  <section class="over">
    <p class="code">404</p>
    <h1>Game over</h1>
    <p>Esta página não existe, ou foi derrotada no caminho.</p>
    <p lang="en" class="en">This page doesn’t exist, or was defeated along the way.</p>
    <p class="continue">Continue? <a href="/">▶ Sim</a> · <a href="/en/" lang="en">▶ Yes</a></p>
  </section>
</Base>

<style>
  .over { display: grid; gap: 16px; justify-items: center; text-align: center; padding-block: 48px; }
  .code { font-family: var(--f-mono); font-size: var(--mono-m); color: var(--muted); }
  h1 { font-size: clamp(2.5rem, 10vw, 4.5rem); color: var(--accent); }
  .continue { font-family: var(--f-pixel); font-size: var(--step-1); }
  .en { color: var(--muted); }
  .continue a { text-decoration: none; animation: blink 1.1s steps(1) infinite; }
</style>
