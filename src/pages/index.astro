---
import Base from '../layouts/Base.astro';
import StatusScreen from '../components/StatusScreen.astro';
import Inventory from '../components/Inventory.astro';
import ContactCard from '../components/ContactCard.astro';
import Clawd from '../components/Clawd.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const featured = projects.filter((p) => p.featured);
import PixelIcon from '../components/PixelIcon.astro';
import type { PixelIconName } from '../data/pixel-icons';
import { person, workLinks, socialLinks, profileUrls } from '../data/contact';
import { t } from '../i18n/ui';

const lang = 'pt';

const timeline = [
  { year: '2012', text: 'Primeiros freelas e estudos em desenvolvimento web, por conta própria.' },
  { year: '2016', text: 'Dou aulas como instrutor de cursos.' },
  { year: '2018', text: 'Edição de vídeo, e os primeiros sistemas web como profissão.' },
  { year: '2021', text: 'Começo a trabalhar com desenvolvimento de software para produtos maiores.' },
  { year: 'hoje', text: 'Desenvolvimento back-end e full-stack, sempre remoto.' },
];

const services: { title: string; text: string; icon: PixelIconName }[] = [
  { title: 'Sistemas web e APIs', icon: 'laravel', text: 'Back-ends em Laravel e PHP: painéis administrativos, APIs REST e as regras de negócio por trás de um produto.' },
  { title: 'Interfaces com Vue', icon: 'vuedotjs', text: 'Telas rápidas e fáceis de usar, de formulários simples a aplicações completas no navegador.' },
  { title: 'Sites WordPress', icon: 'wordpress', text: 'Sites institucionais e temas sob medida, que o próprio cliente consegue atualizar depois.' },
  { title: 'Integrações e automações', icon: 'gear', text: 'Conectar sistemas e serviços de terceiros, e transformar trabalho manual repetitivo em rotina automática.' },
  { title: 'Manutenção e evolução', icon: 'php', text: 'Atualizar, corrigir e melhorar o desempenho de sistemas PHP que já estão em produção.' },
  { title: 'Infraestrutura e deploy', icon: 'docker', text: 'Docker, servidores e bancos PostgreSQL e MySQL, para colocar o sistema no ar e mantê-lo estável.' },
];

const principles: { title: string; text: string; icon: PixelIconName }[] = [
  { title: 'Código que outra pessoa entende', icon: 'code', text: 'Prefiro o simples e legível ao esperto. Quem pegar o código depois de mim precisa conseguir mexer nele sem medo.' },
  { title: 'Comunicação clara', icon: 'chat', text: 'A formação em Comunicação pesa aqui: explico as decisões, aviso cedo quando algo vai atrasar e falo sem jargão com quem não é da área.' },
  { title: 'Remoto de verdade', icon: 'globe', text: 'Trabalho remoto há anos, com escrita organizada, comunicação assíncrona e horários combinados.' },
  { title: 'IA como ferramenta', icon: 'clawd', text: 'Uso o Claude Code no dia a dia para acelerar tarefas repetitivas, revisar código e explorar soluções. As decisões e a responsabilidade pelo código continuam sendo minhas.' },
];

// Brasão da UNEB e símbolo da UniCesumar em pixel art (design/tools/pixelar_sprite.py), exibidos em 1:1
const instLogo: Record<string, { w: number; h: number }> = { uneb: { w: 32, h: 39 }, unicesumar: { w: 40, h: 34 } };

const education = [
  { title: 'Tecnólogo em Sistemas para Internet', school: 'UniCesumar', logo: 'unicesumar', period: '2019–2021', status: 'concluído' },
  { title: 'Bacharelado em Comunicação Social · Rádio e TV', school: 'UNEB', logo: 'uneb', period: '2018–2024', status: 'concluído' },
  { title: 'Licenciatura em Ciências da Computação', school: 'UNEB', logo: 'uneb', period: 'desde 2026', status: 'em andamento', ongoing: true },
];

---

<Base title="Jota Carvalho · Full-stack developer PHP, Laravel e Vue" description="Jota Carvalho (Carlos Alberto P. de Carvalho Júnior), o Janeleiro: full-stack developer em Conceição do Coité (BA). PHP, Laravel, Vue e WordPress." lang={lang}>
  <section id="inicio" class="hero">
    <div class="hero-inner">
      <StatusScreen lang={lang} />
      <a class="press" href="#sobre">{t(lang, 'press')}</a>
    </div>
  </section>

  <section id="sobre" class="block">
    <div class="section-head reveal">
      <span class="label">Sobre</span>
      <h2>Sobre mim</h2>
    </div>
    <div class="about">
      <div class="prose reveal">
        <p>Faço sites e sistemas desde 2012, quando comecei estudando por conta própria e pegando pequenos freelas. Em 2018 isso virou a minha profissão em tempo integral. Hoje construo sistemas web de ponta a ponta, do banco de dados à interface, com PHP, Laravel e Vue, e estou aprendendo Go.</p>
        <p>Antes do código virar profissão, passei por sala de aula e por ilha de edição. Sou formado em Comunicação Social, e isso aparece no meu trabalho: gosto de entender quem vai usar o sistema e de explicar com clareza o que estou construindo.</p>
        <p>Fora do código, jogos são a minha paixão, e é de lá que vem o Janeleiro. Também desenho e atuo.</p>
      </div>
      <div class="log reveal">
        <h3 class="label">Trajetória</h3>
        <ol class="timeline" data-stagger>
          {timeline.map(({ year, text }) => (
            <li class="reveal"><span class="year">{year}</span><p>{text}</p></li>
          ))}
        </ol>
      </div>
    </div>

    <div class="stack-block">
      <h3 class="label reveal">Outras tecnologias</h3>
      <Inventory />
    </div>

    <div class="stack-block">
      <h3 class="label reveal">Formação</h3>
      <ul class="education" data-stagger>
        {education.map(({ title, school, logo, period, status, ongoing }) => (
          <li class:list={['edu', 'reveal', { ongoing }]}>
            <img class="edu-logo" src={`/img/inst/${logo}.png`} width={instLogo[logo].w} height={instLogo[logo].h} alt="" loading="lazy" />
            <span class="edu-title">{title}</span>
            <span class="edu-school">{school} · {period}</span>
            <span class="status">{status}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="trabalho" class="block">
    <div class="section-head reveal">
      <span class="label">O que eu faço</span>
      <h2>Do banco de dados à interface</h2>
    </div>
    <ul class="services" data-stagger>
      {services.map(({ title, text, icon }) => (
        <li class="service reveal">
          <PixelIcon name={icon} size={48} />
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>

    <div class="stack-block">
      <h3 class="label reveal">Como eu trabalho</h3>
      <ul class="principles" data-stagger>
        {principles.map(({ title, text, icon }) => (
          <li class="principle reveal">
            <span class="p-icon">{icon === 'clawd' ? <Clawd size={36} /> : <PixelIcon name={icon} size={24} />}</span>
            <div><h4>{title}</h4><p>{text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="projetos" class="block">
    <div class="walkway" aria-hidden="true"><img class="walker" src="/img/elephpant.png" width="68" height="58" alt="" loading="lazy" /></div>
    <div class="section-head reveal">
      <span class="label">Projetos</span>
      <h2>Trabalhos para clientes, produtos e experimentos</h2>
      <p class="intro">Uma seleção entre mais de 70 projetos que versionei desde 2019.</p>
    </div>
    <div class="filters reveal" role="group" aria-label="Filtrar projetos">
      <button type="button" data-filter="todos" aria-pressed="true">Todos <span>{projects.length}</span></button>
      <button type="button" data-filter="cliente" aria-pressed="false">Clientes <span>{projects.filter((p) => p.kinds.includes('cliente')).length}</span></button>
      <button type="button" data-filter="proprio" aria-pressed="false">Próprios <span>{projects.filter((p) => p.kinds.some((k) => k !== 'cliente')).length}</span></button>
    </div>
    <p class="sr-only" aria-live="polite" id="filter-status"></p>
    <div class="projects">
      <div class="featured-grid" data-stagger>
        {featured.map((project, i) => <ProjectCard project={project} wide={featured.length % 2 === 1 && i === featured.length - 1} />)}
      </div>
      <div class="rows" data-stagger>
        {projects.filter((p) => !p.featured).map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
    <div class="more reveal">
      <p>Os projetos pessoais são onde eu experimento tecnologias novas, como Go e jogos multiplayer no navegador.</p>
      <div class="burrow" aria-hidden="true"><img class="gopher" src="/img/gopher.png" width="64" height="76" alt="" loading="lazy" /></div>
    </div>
  </section>

  <section id="contato" class="block">
    <div class="section-head reveal">
      <span class="label">Contato</span>
      <h2>Vamos conversar</h2>
    </div>
    <p class="reveal">Para falar de trabalho, me mande um e-mail ou uma mensagem no WhatsApp. Nas redes e nos jogos, eu sou o <strong>Janeleiro</strong>.</p>
    <div class="contact-group">
      <h3 class="label reveal">Trabalho</h3>
      <ul class="links work" data-stagger>
        {workLinks.map((link) => <li class="reveal"><ContactCard link={link} /></li>)}
      </ul>
    </div>
    <div class="contact-group">
      <h3 class="label reveal">Redes</h3>
      <ul class="links" data-stagger>
        {socialLinks.map((link) => <li class="reveal"><ContactCard link={link} /></li>)}
      </ul>
    </div>
  </section>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: person.name,
    alternateName: [person.fullName, person.handle],
    jobTitle: 'Full-stack developer',
    email: `mailto:${person.email}`,
    url: 'https://janeleiro.dev',
    image: 'https://janeleiro.dev/img/avatar-512.webp',
    address: { '@type': 'PostalAddress', addressLocality: 'Conceição do Coité', addressRegion: 'BA', addressCountry: 'BR' },
    knowsAbout: ['PHP', 'Laravel', 'Vue.js', 'WordPress', 'Go'],
    sameAs: profileUrls,
  })} />
</Base>

<script>
  import '../scripts/landing.ts';
</script>

<style>
  main { display: grid; }
  .hero { min-height: min(92svh, 820px); display: grid; align-content: center; padding-block: 32px 48px; }
  .hero-inner { display: grid; gap: 28px; }
  .press { justify-self: center; font-family: var(--f-pixel); font-size: var(--step-1); color: var(--accent); text-decoration: none; }
  .press::before { content: '▶'; display: inline-block; margin-right: 0.6em; animation: blink 1.1s steps(1) infinite; }
  .press:hover { color: var(--fg); }

  .block { position: relative; display: grid; gap: 28px; padding-block: 64px; }
  @media (max-width: 640px) { .block { gap: 22px; padding-block: 44px; } }
  /* Divisória em blocos de pixel */
  .block::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: repeating-linear-gradient(90deg, var(--edge) 0 8px, transparent 8px 16px);
  }

  .about { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  @media (max-width: 760px) { .about { grid-template-columns: 1fr; } }
  .prose { display: grid; gap: 14px; }
  .log { display: grid; gap: 14px; background: var(--panel); border: 2px solid var(--edge); padding: 18px; }
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .timeline li { display: grid; grid-template-columns: 3.4rem minmax(0, 1fr); gap: 12px; align-items: baseline; font-size: var(--step--1); }
  .year { font-family: var(--f-mono); font-size: var(--mono-m); color: var(--accent); }

  .stack-block { display: grid; gap: 14px; }

  .services { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 12px; }
  .service {
    display: grid; gap: 10px; align-content: start; padding: 20px;
    background: var(--panel); border: 1px solid var(--edge); transition: transform .15s, border-color .15s;
  }
  .service:hover { transform: translateY(-3px); border-color: var(--accent); }
  .service:hover :global(.pixel-icon) { animation: hop .5s steps(3); }
  .service h3, .principle h4 { font-family: var(--f-pixel); font-size: var(--step-0); line-height: 1.2; margin: 0; }
  .service p, .principle p { color: var(--muted); font-size: var(--step--1); }
  :global(html.js) .service :global(.pixel-icon) { clip-path: inset(0 0 100% 0); }
  :global(html.js) .service:global(.in) :global(.pixel-icon) { clip-path: none; animation: draw .6s steps(12) calc(var(--i, 0) * 70ms + .2s) backwards; }

  .principles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 12px 28px; }
  .principle { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 14px; align-items: start; padding-block: 12px; border-top: 1px dotted var(--edge); }
  .principle div { display: grid; gap: 6px; }
  .p-icon { height: 24px; display: grid; place-items: center; }

  @keyframes draw { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes hop { 50% { transform: translateY(-5px); } }
  @media (prefers-reduced-motion: reduce) { :global(html.js) .service :global(.pixel-icon) { clip-path: none; } }

  .education { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; }
  .edu {
    display: grid; gap: 4px; align-content: start; grid-template-columns: 1fr auto;
    padding: 14px 16px; background: var(--panel); border: 1px solid var(--edge);
  }
  .edu > :not(.edu-logo) { grid-column: 1; }
  .edu-logo { grid-column: 2; grid-row: 1 / span 3; align-self: start; image-rendering: pixelated; }
  .edu-title { font-size: var(--step--1); }
  .edu-school { color: var(--muted); font-size: var(--step--1); }
  .status { font-family: var(--f-mono); font-size: var(--mono-s); color: var(--cool); margin-top: 4px; }
  .edu.ongoing { border-style: dashed; }
  .edu.ongoing .status { color: var(--accent); }

  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters button {
    font: inherit; font-family: var(--f-pixel); font-size: var(--step--1); cursor: pointer;
    padding: 6px 14px; background: var(--panel); color: var(--muted); border: 1px solid var(--edge);
    transition: color .15s, border-color .15s;
  }
  .filters button span { opacity: .6; }
  .filters button:hover { color: var(--fg); }
  .filters button[aria-pressed='true'] { color: var(--bg); background: var(--accent); border-color: var(--accent); }
  .filters button[aria-pressed='true']::before { content: '▸ '; }
  .projects { display: grid; gap: 14px; }
  .intro { color: var(--muted); }
  .featured-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 14px; }
  .rows { display: grid; gap: 14px; }
  .featured-grid:not(:has(> :not([hidden]))), .rows:not(:has(> :not([hidden]))) { display: none; }

  .more {
    position: relative; overflow: hidden; min-height: 110px; display: grid; align-content: center;
    background: var(--panel); border: 2px solid var(--edge); padding: 20px 132px 20px 22px;
  }
  .more p { color: var(--muted); font-size: var(--step--1); }
  @media (max-width: 560px) { .more { padding: 20px 20px 116px; } }

  /* elePHPant andando sobre a divisória, ida e volta */
  .walkway { position: absolute; left: 0; right: 0; bottom: 100%; height: 58px; margin-bottom: -4px; container-type: inline-size; pointer-events: none; }
  .walker { position: absolute; left: 0; bottom: 0; width: 68px; height: auto; image-rendering: pixelated; animation: walk 26s linear infinite, bob .5s steps(2) infinite; }
  @keyframes walk {
    0% { translate: 0 0; scale: 1 1; }
    48% { translate: calc(100cqw - 68px) 0; scale: 1 1; }
    50% { translate: calc(100cqw - 68px) 0; scale: -1 1; }
    98% { translate: 0 0; scale: -1 1; }
    100% { translate: 0 0; scale: 1 1; }
  }
  @keyframes bob { 50% { transform: translateY(-2px); } }

  /* Gopher espiando da toca no canto do bloco "em construção" */
  .burrow {
    position: absolute; right: 22px; bottom: 0; width: 84px; height: 96px; overflow: hidden;
    border-bottom: 6px solid var(--edge);
  }
  .gopher { position: absolute; left: 4px; bottom: 0; width: 64px; height: auto; image-rendering: pixelated; animation: peek 7s steps(6) infinite; }
  @keyframes peek {
    0%, 12% { transform: translateY(100%); }
    22%, 70% { transform: translateY(0); }
    76% { transform: translateY(0) rotate(-6deg); }
    82% { transform: translateY(0) rotate(0); }
    92%, 100% { transform: translateY(100%); }
  }
  @media (prefers-reduced-motion: reduce) { .gopher { transform: none; } }

  .contact-group { display: grid; gap: 12px; }
  .links { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
  .links.work { grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); }
</style>
