---
// Outras tecnologias, como blocos com a logo em pixel art.
// A logo é "desenhada" de cima para baixo quando o bloco aparece na tela.
import PixelIcon from './PixelIcon.astro';
import Clawd from './Clawd.astro';
import type { PixelIconName } from '../data/pixel-icons';
import type { Lang } from '../i18n/ui';
import { content } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { techTitle, learning } = content[lang].about;

const items: { name: string; icon: PixelIconName; training?: boolean }[] = [
  { name: 'JavaScript', icon: 'javascript' },
  { name: 'TypeScript', icon: 'typescript' },
  { name: 'SQL', icon: 'database' },
  { name: 'PostgreSQL', icon: 'postgresql' },
  { name: 'MySQL', icon: 'mysql' },
  { name: 'Docker', icon: 'docker' },
  { name: 'AWS', icon: 'amazonwebservices' },
  { name: 'Electron', icon: 'electron' },
  { name: 'Claude Code', icon: 'clawd' },
  { name: 'Go', icon: 'go', training: true },
];
---

<ul class="inv" aria-label={techTitle} data-stagger>
  {items.map(({ name, icon, training }) => (
    <li class:list={['tile', 'reveal', { training }]}>
      {icon === 'clawd'
        ? <span class="clawd-box"><Clawd size={54} /></span>
        : <PixelIcon name={icon} size={48} />}
      <span class="name">{name}</span>
      {training && <span class="tag">{learning}</span>}
    </li>
  ))}
</ul>

<style>
  .inv { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(156px, 30%), 1fr)); gap: 10px; }
  .tile {
    position: relative; display: grid; justify-items: center; gap: 10px; padding: 16px 8px 12px;
    background: var(--panel); border: 1px solid var(--edge);
    transition: border-color .15s, transform .15s;
  }
  .tile:hover { border-color: var(--fg); transform: translateY(-3px); }
  @media (max-width: 480px) { .tile { padding: 12px 4px 10px; gap: 6px; } }
  .tile:hover :global(.pixel-icon) { animation: hop .5s steps(3); }
  .name { font-family: var(--f-mono); font-size: var(--mono-s); line-height: 1.1; text-align: center; }
  .clawd-box { height: 48px; display: grid; place-items: center; }
  .training { border-style: dashed; border-color: var(--cool); }
  .tag {
    position: absolute; top: -10px; right: 8px; font-family: var(--f-mono); font-size: 0.95rem; line-height: 1.2;
    background: var(--bg); color: var(--cool); padding: 0 6px; border: 1px solid var(--cool);
  }
  :global(html.js) .tile :global(.pixel-icon) { clip-path: inset(0 0 100% 0); }
  :global(html.js) .tile:global(.in) :global(.pixel-icon) {
    clip-path: none;
    animation: draw .6s steps(12) calc(var(--i, 0) * 70ms + .15s) backwards;
  }
  @keyframes draw { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes hop { 50% { transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { :global(html.js) .tile :global(.pixel-icon) { clip-path: none; } }
</style>
